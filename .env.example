# susu-web — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# SECURITY: every variable here is bundled into the browser. Only browser-safe
# values may appear in this file. Never add a service-role key, secret key,
# database password, or private key — `src/lib/env.ts` will refuse to start if
# it detects one.

# Public URL of this app. Authentication emails redirect here, so this exact
# origin must also be listed in Supabase's redirect allowlist
# (Authentication -> URL Configuration -> Redirect URLs):
#
#   {VITE_APP_URL}/app              where a confirmed signup lands
#   {VITE_APP_URL}/reset-password   where a recovery link lands
#
# If they are not listed, Supabase substitutes the project's Site URL instead of
# refusing, so the email arrives and the link appears broken. That failure looks
# like a bug in this app rather than a missing setting, which is why it is worth
# configuring both at once.
VITE_APP_URL=http://localhost:5173

# Supabase project. The anon/publishable key is public by design and is protected
# by Row Level Security. It must never be the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stellar network: local | testnet | mainnet
# Mainnet is out of scope until the Mainnet readiness gate is passed.
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Set to true when using a custom/private RPC endpoint whose URL hostname
# does not explicitly contain "testnet" or "mainnet" (e.g. QuickNode or private node).
VITE_STELLAR_RPC_IS_CUSTOM=false

# Deployed contract IDs (C... addresses are public). These are the Testnet
# deployments recorded in susu-contracts/docs/TESTNET.md. Mainnet IDs must never
# be mixed in.
VITE_FACTORY_CONTRACT_ID=CCC7KAX4V4GJD6FVG6GSYQ4I2D2B3CWEOQMIX6YM4QBGXTA6INCGRUYC
VITE_USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Block explorer base URL for the selected network.
VITE_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet

# The Susu API (`susu-api`). Optional: the app reads group state straight from
# the chain and works without a backend, so only invite codes need this — and the
# screens that do say so rather than failing obscurely.
#
# Include the version prefix. The API serves everything under `/api/v1`, and a
# base URL without it produces 404s that look like unimplemented routes.
VITE_API_BASE_URL=http://localhost:3000/api/v1
